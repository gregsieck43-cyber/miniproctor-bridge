{
  "tools": {
    "profile": "minimal",
    "deny": ["*"]
  },
  "models": {
    "mode": "merge",
    "providers": {
      "miniproctor-deepseek": {
        "baseUrl": "https://api.deepseek.com",
        "apiKey": { "source": "env", "provider": "default", "id": "DEEPSEEK_API_KEY" },
        "api": "openai-completions",
        "models": [{
          "id": "deepseek-flash",
          "name": "DeepSeek Flash",
          "reasoning": false,
          "input": ["text"],
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
          "contextWindow": 128000,
          "maxTokens": 8192
        }]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": { "primary": "miniproctor-deepseek/deepseek-flash" }
    }
  }
}
